# EditorConfig - https://editorconfig.org
# Helps developers define and maintain consistent coding styles

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md}]
trim_trailing_whitespace = false

[*.{css,js,mjs,json}]
indent_style = space
indent_size = 2

[*.{html}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.sol]
indent_style = space
indent_size = 2