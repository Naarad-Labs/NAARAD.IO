# Copy to .env.local and fill in. .env.local is ignored by git.
#
# PUBLIC values (safe to ship in the browser; they go into app/config.js):
SUPABASE_URL=
SUPABASE_ANON_KEY=
#
# SECRET. Needed only to apply database migrations from this machine, with
#   node supabase/apply.mjs
# Supabase dashboard > Project Settings > Database > Connection string (URI),
# with your database password filled in. Never commit it, never put it under
# app/, never paste it into a chat. The service-role key is NOT needed.
DATABASE_URL=
